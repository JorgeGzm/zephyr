config I2C_GD32
	bool "GigaDevice GD32 I2C driver"
	default y
	depends on DT_HAS_GD_GD32_I2C_ENABLED
	select PINCTRL
	help
	  Enables GigaDevice GD32 I2C driver (classic controller).

config I2C_GD32_V2
	bool "GigaDevice GD32 v2 I2C driver"
	default y
	depends on DT_HAS_GD_GD32_I2C_V2_ENABLED
	select PINCTRL
	help
	  Enables the GigaDevice GD32 "v2" I2C driver (TIMINGR/NBYTES/AUTOEND
	  controller, as found on the GD32VW55x).
