/dts-v1/;

#include <gd/gd32w51x/gd32w515xi.dtsi>
#include "gd_xd_w515_eval-pinctrl.dtsi"

/ {
	model = "GigaDevice GD-xD-W515-EVAL";
	compatible = "gd,gd-xd-w515-eval";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,flash-controller = &fmc;
		zephyr,entropy = &trng;
		zephyr,crc = &crc;
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
			label = "LED1";
		};

		led2: led2 {
			gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>;
			label = "LED2";
		};

		led3: led3 {
			gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
			label = "LED3";
		};

		led4: led4 {
			gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
			label = "LED4";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		/* LCD backlight (transistor Q1 on the LCD module) */
		backlight: backlight {
			pwms = <&pwm2 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "LCD backlight";
		};
	};

	aliases {
		led0 = &led1;
		led1 = &led2;
		led2 = &led3;
		led3 = &led4;
		pwm-led0 = &backlight;
		watchdog0 = &fwdgt;
		rtc = &rtc;
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

/* USART2 on PB10/PB11 is wired to the CH340E on the micro-USB connector */
&usart2 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart2_default>;
	pinctrl-names = "default";
};

/* GD30BC2416 battery charger: only answers with a battery or a supply on BAT */
&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

/* ST7735S LCD module connector: DC on PA10, RST on PC6, no MISO */
&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 13 GPIO_ACTIVE_LOW>;
};

/* GSL6157 fingerprint module connector: STD on PB5, IRQ on PA12 */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 8 GPIO_ACTIVE_LOW>;
};

/* GD25Q128E (marked GD25T28E) 16 MiB QSPI NOR flash */
&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-names = "default";

	gd25q128: qspi-nor-flash@0 {
		compatible = "gd,gd32-qspi-nor";
		reg = <0>;
		size = <DT_SIZE_M(128)>;
		qspi-max-frequency = <DT_FREQ_M(30)>;
		jedec-id = [c8 40 18];
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			qspi_storage_partition: partition@0 {
				label = "qspi-storage";
				reg = <0x00000000 DT_SIZE_M(16)>;
			};
		};
	};
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
};

&timer2 {
	status = "okay";
	prescaler = <179>;

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&pwm2_default>;
		pinctrl-names = "default";
	};
};

&fwdgt {
	status = "okay";
};

&wwdgt {
	status = "okay";
};

/* No LXTAL on the board: the RTC runs on the IRC32K */
&rtc {
	status = "okay";
};

&crc {
	status = "okay";
};

&trng {
	status = "okay";
};

&cau {
	status = "okay";
};

&hau {
	status = "okay";
};

&lvd {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&flash0 {
	/*
	 * MCUboot layout: 4 KB pages, 864 KB slots (216 pages, MCUboot needs
	 * BOOT_MAX_IMG_SECTORS=256), swap with scratch. Without MCUboot the
	 * application is linked at the start of the flash.
	 */
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(128)>;
		};

		storage_partition: partition@20000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x00020000 DT_SIZE_K(128)>;
		};

		slot0_partition: partition@40000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00040000 DT_SIZE_K(864)>;
		};

		slot1_partition: partition@118000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00118000 DT_SIZE_K(864)>;
		};

		scratch_partition: partition@1f0000 {
			compatible = "zephyr,mapped-partition";
			label = "image-scratch";
			reg = <0x001f0000 DT_SIZE_K(64)>;
		};
	};
};
